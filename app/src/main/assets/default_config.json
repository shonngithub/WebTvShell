  "scripts": [
    {
      "id": "cctv-player-bootstrap",
      "name": "央视动态播放器启动",
      "enabled": true,
      "body": "(function(){var n=0,t=setInterval(function(){var v=document.querySelector('#h5player_player')||document.querySelector('#player video');if(v){v.autoplay=true;var q=v.play();if(q&&q.catch)q.catch(function(){v.muted=true;v.play();});}if(++n>30)clearInterval(t);},500);})();"
    },
    {
      "id": "yangshipin-player-bootstrap",
      "name": "央视频卫视动态播放器启动",
      "enabled": true,
      "body": "(function(){var n=0,t=setInterval(function(){try{var v=document.querySelector('video.video-js')||document.querySelector('video');if(v){v.autoplay=true;v.playsInline=false;var p=v.play();if(p&&p.catch)p.catch(function(){v.muted=true;v.play();});var f=document.querySelector('.full.full2');if(f)try{f.click();}catch(e){}clearInterval(t);}if(++n>40)clearInterval(t);}catch(e){if(++n>40)clearInterval(t);}},500);})();"
    }
  ]
